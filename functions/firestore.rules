rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Raw documents include private IPs. Admin SDK functions enforce access
    // and return public projections, including for existing legacy documents.
    match /scores/{scoreId} {
      allow read, write: if false;
    }
    match /chat/{messageId} {
      allow read, write: if false;
    }
    match /validation_tokens/{tokenId} {
      allow read, write: if false;
    }
    match /_internal/{documentId} {
      allow read, write: if false;
    }
  }
}
